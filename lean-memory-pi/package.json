    "url": "git+https://github.com/abianbiya/skills.git",
    "directory": "lean-memory-pi"
  },
  "homepage": "https://github.com/abianbiya/skills/tree/main/lean-memory-pi#readme",
  "bugs": { "url": "https://github.com/abianbiya/skills/issues" },
  "files": ["index.ts", "store.ts", "preview.ts", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "pi": { "extensions": ["./index.ts"] },
  "dependencies": { "pi-memory": "0.4.2" },
